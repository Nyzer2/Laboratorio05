html { color: rgb(191, 191, 191) !important; background: rgb(31, 31, 31) !i=
mportant; }

body, body > .container { background-color: rgb(31, 31, 31); background-ima=
ge: none !important; }

input, select, textarea, button { color: rgb(191, 191, 191); background-col=
or: rgb(31, 31, 31); border-color: rgb(97, 97, 97) !important; }

input[type=3D"radio"]::before, input[type=3D"radio"]::after { background-co=
lor: rgb(97, 97, 97) !important; }

text { fill: rgb(191, 191, 191); }

font { color: rgb(191, 191, 191); }
