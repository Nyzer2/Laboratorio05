@charset "utf-8";

.transplanted-form-element-container input, .transplanted-form-element-cont=
ainer textarea, .transplanted-form-element { user-select: text; text-align:=
 center; }

.celtra-display-image-overlay { position: absolute; inset: 0px; z-index: 30=
; background-repeat: no-repeat; background-position: center center; }

.celtra-display-image-overlay .celtra-back-button { position: absolute; top=
: 0px; width: 30px; height: 30px; background: url("https://cache-ssl.celtra=
.com/api/static/v4a02a60b/runner/clazzes/CreativeUnit/back.png") 0% 0% / 30=
px 60px; }

.celtra-display-image-overlay .celtra-back-button.left { left: 0px; }

.celtra-display-image-overlay .celtra-back-button.right { right: 0px; }

.celtra-display-image-overlay .celtra-back-button.touched { background-posi=
tion: 0px 100%; }

.celtra-fit-to-container { max-width: 100%; max-height: 100%; }

.celtra-center-content { width: 100%; height: 100%; text-align: center; }

.celtra-center-content::before { content: ""; display: inline-block; height=
: 100%; vertical-align: middle; }

.celtra-center-content > * { vertical-align: middle; }

.celtra-creative-border { position: absolute; width: 100%; height: 100%; z-=
index: 20; border-style: solid; box-sizing: border-box; pointer-events: non=
e; }

.celtra-creative-unit-with-variants { position: absolute; font-family: Helv=
etica; font-size: 12pt; width: 100%; height: 100%; }

.celtra-creative-unit-with-variants, .celtra-creative-unit-with-variants * =
{ text-size-adjust: none; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); us=
er-select: none; margin: 0px; padding: 0px; }

.celtra-creative-unit-with-variants input, .celtra-creative-unit-with-varia=
nts textarea { user-select: text; text-align: center; }

.celtra-creative-unit-variant { position: absolute; z-index: 10; }

.celtra-screen-holder { position: absolute; inset: 0px; width: 100%; height=
: 100%; z-index: 20; }

.celtra-screen { position: absolute; top: 0px; left: 0px; pointer-events: n=
one; overflow: hidden; }

.celtra-screen > * { pointer-events: auto; }

.celtra-nested-container { overflow: hidden; z-index: 0; }

.celtra-nested-container.empty { background-color: rgb(0, 0, 0); background=
-image: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABwAAAAcCAMAAABF=
0y+mAAAAD1BMVEX////MzMzMzMzMzMzMzMyungt0AAAABHRSTlMAEB/gwuUpDAAAAC5JREFUeAF=
joASwQACGAOWSTIyMjAhJIIcJSRImg5AfppKjkmDAjCLBQpkkBQAAEtUDLd7kNEwAAAAASUVORK=
5CYII=3D"); background-position: center center; background-repeat: no-repea=
t; border: 1px solid rgb(64, 64, 64); box-sizing: border-box; }

.celtra-screen-object { background: rgba(0, 0, 0, 0); }

.celtra-hotspot { cursor: pointer; }

.celtra-screen-object.animated div, .celtra-screen-object.animated > img, .=
celtra-screen-object.animated .celtra-screen-object div, .celtra-screen-obj=
ect.animated .celtra-screen-object > img { transform: perspective(1px); }

.celtra-picture { overflow: hidden; }

.celtra-picture.empty { background-color: rgb(0, 0, 0); background-position=
: center center; background-repeat: no-repeat; background-size: 28px; borde=
r: 2px solid rgb(64, 64, 64); box-sizing: border-box; }

.celtra-texty .no-break { white-space: nowrap; word-break: keep-all; overfl=
ow-wrap: normal; }

.celtra-texty .scroll-container { position: relative; width: 100%; height: =
100%; overflow: hidden; outline: transparent solid 1px; }

.celtra-texty .scroll-container > div { position: absolute; width: 100%; bo=
x-sizing: border-box; }

.celtra-texty .celtra-vertical-scrollbar { position: absolute; top: 0px; ri=
ght: 0px; width: 5px; z-index: 2; }

.celtra-texty .celtra-vertical-scrollbar.outer { right: -5px; }

.celtra-texty.baking-animated div, .celtra-screen-object.baking-animated .c=
eltra-texty div { will-change: transform; }

.celtra-shapey { box-sizing: border-box; }

.celtra-shapey div { position: absolute; left: 0px; top: 0px; height: 100%;=
 width: 100%; overflow: hidden; box-sizing: border-box; background-clip: pa=
dding-box; border-width: 0px; border-style: solid; border-color: transparen=
t; transition: inherit; }
