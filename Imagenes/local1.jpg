ound: linear-gradient(135deg, rgb(42, 167, 121), rgb(47, 136, 188)); }

:root .has-purple-crush-gradient-background { background: linear-gradient(1=
35deg, rgb(71, 207, 209), rgb(98, 75, 210) 50%, rgb(159, 71, 209)); }

