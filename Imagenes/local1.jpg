------MultipartBoundary--Rjxbo1rxfv4mq8GIOUk1rXpIi6K5Yk2cFkYf1ksEPR----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: chrome-extension://alncdjedloppbablonallfbkeiknmkdi/css/night-eye-custom-styles.css

@charset "utf-8";

::selection { background: rgb(51, 140, 204); color: rgb(255, 255, 255); }

:root[nighteye=3D"active"] .CodeMirror-cursor { border-color: rgb(206, 206,=
 206) !important; }

:root[nighteye=3D"active"] * { mix-blend-mode: unset !important; }

:root[nighteye=3D"active"] img { mix-blend-mode: unset !important; backgrou=
nd-blend-mode: unset !important; }

:root[nighteye=3D"active"] figure table tr { background-color: transparent;=
 }

:root[nighteye=3D"active"] figure table tr:nth-child(2n+1) { background-col=
or: rgb(26, 26, 26); }

body.is-withMagicUnderlines .markup--anchor { text-decoration: underline; }

body.is-withMagicUnderlines .postArticle.is-withAccentColors .markup--quote=
.is-other { background-image: linear-gradient(rgba(51, 204, 138, 0.2), rgba=
(51, 204, 138, 0.2)) !important; }

img.tex-formula, img[src*=3D"//tex."] { filter: invert(80%); }

.shopify-section .vertical-wrapper { background: transparent !important; }

img[src*=3D"//openbenchmarking.org/embed.php"] { filter: invert(90%) hue-ro=
tate(180deg) contrast(90%); }

.cm-cursor { border-color: rgb(221, 221, 221) !important; }

.inline_player .progbar { filter: invert(80%); }

.inline_player .prev_cell, .inline_player .next_cell { filter: invert(50%);=
 }

.inline_player .playbutton, .track_list .play_status { background: rgb(95, =
95, 95) !important; }

:root[nighteye=3D"active"] body.single #main-content .post-thumb .single-th=
umbnail img { z-index: 0; }

.background-image-holder, .background-image, .background-image-small { back=
ground-image: none !important; }
------MultipartBoundary--Rjxbo1rxfv4mq8GIOUk1rXpIi6K5Yk2cFkYf1ksEPR----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: chrome-extension://alncdjedloppbablonallfbkeiknmkdi/css/night-eye-scroll.css

@charset "utf-8";

::-webkit-scrollbar { width: 14px; height: 14px; }

nav.trending__nav ::-webkit-scrollbar { width: 8px; height: 8px; }

::-webkit-scrollbar-button { background-color: rgb(62, 67, 70) !important; =
}

::-webkit-scrollbar-track { background-color: rgb(100, 100, 100) !important=
; }

::-webkit-scrollbar-track-piece { background-color: rgb(62, 67, 70) !import=
ant; }

::-webkit-scrollbar-thumb { height: 50px; background-color: rgb(36, 36, 36)=
 !important; border: 2px solid rgb(62, 67, 70) !important; }

::-webkit-scrollbar-corner { }

::-webkit-resizer { }

::-webkit-scrollbar-button:vertical:start:decrement { background: linear-gr=
adient(130deg, rgb(105, 105, 105) 40%, rgba(255, 0, 0, 0) 41%), linear-grad=
ient(230deg, rgb(105, 105, 105) 40%, rgba(0, 0, 0, 0) 41%), linear-gradient=
(0deg, rgb(105, 105, 105) 40%, rgba(0, 0, 0, 0) 31%) rgb(182, 182, 182); }

::-webkit-scrollbar-button:vertical:end:increment { background: linear-grad=
ient(310deg, rgb(105, 105, 105) 40%, rgba(0, 0, 0, 0) 41%), linear-gradient=
