.tdb_single_bg_featured_image { margin-bottom: 26px; overflow: hidden; }

.tdb-featured-image-bg { background-color: rgb(38, 38, 38); background-posi=
tion: center center; }

.tdb_single_bg_featured_image .tdb-caption-text { z-index: 1; text-align: l=
eft; font-size: 11px; font-style: italic; font-weight: normal; line-height:=
 17px; color: rgb(191, 191, 191); display: block; }

.tdb_single_bg_featured_image.tdb-content-horiz-center .tdb-caption-text { =
text-align: center; left: 0px; right: 0px; margin-left: auto; margin-right:=
 auto; }

.tdb_single_bg_featured_image.tdb-content-horiz-right .tdb-caption-text { t=
ext-align: right; left: auto; right: 0px; }

.tdi_65 .tdb-featured-image-bg { background: url("https://prensaregional.pe=
/wp-content/uploads/2025/09/Perumin-37-Exposicion-25092025-scaled.jpg") cen=
ter 50% / cover no-repeat; padding-bottom: 600px; }

.tdi_65 .tdb-caption-text { margin: 6px 0px 0px; }

html:not(.td-md-is-ios):not(.td-md-is-android) body:not(.tdb-autoload-ajax)=
 .tdi_65 .tdb-featured-image-bg { background-attachment: scroll; }

.tdi_65 .tdb-featured-image-bg:hover::before { opacity: 0; }

@media (max-width: 767px) {
  .tdi_65 .tdb-featured-image-bg { padding-bottom: 450px; }
}
