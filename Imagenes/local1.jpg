35deg, rgb(122, 87, 31), rgb(17, 61, 69)); }

:root .has-nightshade-gradient-background { background: linear-gradient(135=
deg, rgb(53, 22, 90), rgb(51, 201, 204)); }

:root .has-midnight-gradient-background { background: linear-gradient(135de=
g, rgb(27, 27, 106), rgb(80, 128, 211)); }

.has-regular-font-size { font-size: 1em; }

.has-larger-font-size { font-size: 2.625em; }

.has-normal-font-size { font-size: var(--wp--preset--font-size--normal); }

.has-huge-font-size { font-size: var(--wp--preset--font-size--huge); }

.has-text-align-center { text-align: center; }

.has-text-align-left { text-align: left; }

.has-text-align-right { text-align: right; }

