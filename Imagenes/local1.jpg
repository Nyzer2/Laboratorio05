                </div>
            </div>
        </div>

        <div class=3D"scr_heading">
            Ad Preferences
        </div>
        <div class=3D"scr_close"></div>

    </div>

    <div id=3D"scr_undo_cont">
        The Ad has been hidden. You can undo the action by clicking <span i=
d=3D"scr_undo_btn">here</span>.
    </div>

</div>


<div class=3D"header_wrap">
    <div class=3D"header">Ad</div>
    <div class=3D"sep"></div>
    <div class=3D"brand_txt" id=3D"brand_txt"><a href=3D"https://popular-tr=
ends.com/" target=3D"_blank">Popular Trends</a></div>
</div>

</div>
</div>


</body></html>
